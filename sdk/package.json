{
  "name": "gtfs-sdk",
  "version": "0.2.0",
  "description": "GTFS Analyzer validation engine for Browser and Node.js.",
  "license": "MIT",
  "keywords": [
    "gtfs",
    "gtfs-validator",
    "transit",
    "public-transport",
    "validation",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttezer/gtfs-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/ttezer/gtfs-analyzer/issues"
  },
  "homepage": "https://github.com/ttezer/gtfs-analyzer#readme",
  "type": "module",
  "files": [
    "dist",
    "pkg/gtfs_wasm.js",
    "pkg/gtfs_wasm_bg.wasm",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "version:check": "node scripts/check-version.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "build": "npm run clean && npm run version:check && npm run wasm:build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:config-parity": "node scripts/config-parity-test.mjs",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs",
    "package:check": "node scripts/check-package.mjs",
    "pack:check": "npm run build && npm run package:check",
    "prepublishOnly": "npm run pack:check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0"
  }
}

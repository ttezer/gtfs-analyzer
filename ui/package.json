{
  "name": "gtfs-validator-ui",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/wasm --target web --out-dir ../../ui/pkg",
    "wasm:threads": "node scripts/build-wasm-threads.mjs",
    "wasm:64": "node scripts/build-wasm64.mjs",
    "wasm:64:parity": "node scripts/check-wasm64-parity.mjs",
    "wasm:all": "npm run wasm && npm run wasm:threads && npm run wasm:64",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@vitest/coverage-v8": "^2.1.9",
    "binaryen": "^130.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-top-level-await": "^1.4.0",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "kk-date": "^4.1.3",
    "leaflet": "^1.9.4",
    "lucide": "^1.21.0"
  }
}

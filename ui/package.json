{
  "name": "gtfs-validator-ui",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/wasm --target web --out-dir ../../ui/pkg",
    "wasm:threads": "node scripts/build-wasm-threads.mjs",
    "wasm:all": "npm run wasm && npm run wasm:threads",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-top-level-await": "^1.4.0",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "kk-date": "^4.1.3"
  }
}

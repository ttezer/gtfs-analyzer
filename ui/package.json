{
  "name": "gtfs-validator-ui",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "wasm": "wasm-pack build ../crates/wasm --target web --out-dir ../../ui/pkg",
    "wasm:threads": "node scripts/build-wasm-threads.mjs",
    "wasm:64": "node scripts/build-wasm64.mjs",
    "wasm:64:parity": "node scripts/check-wasm64-parity.mjs",
    "wasm:all": "npm run wasm && npm run wasm:threads && npm run wasm:64",
    "sdk:build": "npm --prefix ../sdk ci --ignore-scripts && npm --prefix ../sdk run build",
    "predev": "npm run sdk:build",
    "prebuild": "npm run sdk:build",
    "dev": "vite",
    "locales:export": "node scripts/export-locales.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@vitest/coverage-v8": "^4.1.10",
    "binaryen": "^130.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.6",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "kk-date": "^4.1.3",
    "leaflet": "^1.9.4",
    "lucide": "^1.21.0"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // locale-parity.test.ts, Rust CLI'ye gömülen türetilmiş sözlükleri
    // (crates/cli/locales/*.json) doğrudan import ederek drift'i yakalar.
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src", "pkg"]
}
